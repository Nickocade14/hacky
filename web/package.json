{
  "name": "hacky-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "api:types": "openapi-typescript ../docs/openapi.yaml -o src/lib/schema.d.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json",
    "build": "npm run api:types && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5174",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^20.0.10",
    "openapi-typescript": "^7.10.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.0.8"
  },
  "engines": { "node": ">=24" }
}

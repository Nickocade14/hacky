# Copy to server/.env and fill in. Never commit .env.

# --- Server ---
PORT=8787
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hacky?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-string
# Web origins allowed by CORS (comma-separated)
CORS_ORIGIN=http://localhost:5173
# Demo sign-in is disabled by default. Keep it disabled in production.
DEMO_MODE=false

# --- Email (nodemailer) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Hacky <no-reply@example.com>"
# Base URL for the links in verification / reset emails (the web pages /verify and /reset)
APP_URL=http://localhost:5173

# --- AI (embeddings + chat, Gemini via the AI SDK) ---
GOOGLE_GENERATIVE_AI_API_KEY=

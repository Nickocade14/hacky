# Copy to server/.env and fill in. Never commit .env.

# --- Server ---
PORT=8787
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hacky?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-string
# Web origins allowed by CORS (comma-separated)
CORS_ORIGIN=http://localhost:5173
# Demo sign-in is disabled by default. Keep it disabled in production.
DEMO_MODE=false

# --- Email (nodemailer) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Hacky <no-reply@example.com>"

# --- AI (Gemini embeddings via fetch; chat via the AI SDK) ---
# Chat model: google (Gemini, default) or anthropic (Claude). Embeddings always use Gemini.
AI_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=
# Only needed with AI_PROVIDER=anthropic (Claude Console API key).
ANTHROPIC_API_KEY=
# Optional model overrides: GEMINI_CHAT_MODEL (default gemini-3.8-flash), ANTHROPIC_CHAT_MODEL (default claude-haiku-5-5)

digraph Hacky {
	bgcolor="#F8FAFC" compound=true concentrate=false fontname="DejaVu Sans" margin=.18 newrank=true nodesep=0.65 outputorder=edgesfirst overlap=false pad=.42 rankdir=LR ranksep=1.3 splines=spline
	node [fontname="DejaVu Sans" shape=plain]
	edge [arrowsize=0.75 dir=both fontcolor="#475569" fontname="DejaVu Sans" fontsize=12 labeldistance=1.4 penwidth=1.65]
	ConnectionRequest [label=<<TABLE BORDER="1" COLOR="#D97706" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#D97706" CELLPADDING="12"><FONT COLOR="white" POINT-SIZE="18"><B>ConnectionRequest</B></FONT> <FONT COLOR="white" POINT-SIZE="11">  requests</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F8FAFC" CELLPADDING="7"><FONT COLOR="#132338" POINT-SIZE="12"><B>_id</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F8FAFC" CELLPADDING="7"><FONT COLOR="#526578" POINT-SIZE="11">ObjectId</FONT> <FONT COLOR="#D97706" POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#132338" POINT-SIZE="12"><B>event</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#526578" POINT-SIZE="11">ObjectId → Event</FONT> <FONT COLOR="#D97706" POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F8FAFC" CELLPADDING="7"><FONT COLOR="#132338" POINT-SIZE="12"><B>from / to</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F8FAFC" CELLPADDING="7"><FONT COLOR="#526578" POINT-SIZE="11">ObjectId → Profile</FONT> <FONT COLOR="#D97706" POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#132338" POINT-SIZE="12"><B>status</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#526578" POINT-SIZE="11">enum</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F8FAFC" CELLPADDING="7"><FONT COLOR="#132338" POINT-SIZE="12"><B>team</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F8FAFC" CELLPADDING="7"><FONT COLOR="#526578" POINT-SIZE="11">ObjectId → Team</FONT> <FONT COLOR="#D97706" POINT-SIZE="9">FK</FONT></TD></TR></TABLE>>]
	Event [label=<<TABLE BORDER="1" COLOR="#059669" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#059669" CELLPADDING="12"><FONT COLOR="white" POINT-SIZE="18"><B>Event</B></FONT> <FONT COLOR="white" POINT-SIZE="11">  events</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F8FAFC" CELLPADDING="7"><FONT COLOR="#132338" POINT-SIZE="12"><B>_id</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F8FAFC" CELLPADDING="7"><FONT COLOR="#526578" POINT-SIZE="11">ObjectId</FONT> <FONT COLOR="#059669" POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#132338" POINT-SIZE="12"><B>name</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#526578" POINT-SIZE="11">string</FONT></TD></TR></TABLE>>]
	Block [label=<<TABLE BORDER="1" COLOR="#D97706" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#D97706" CELLPADDING="12"><FONT COLOR="white" POINT-SIZE="18"><B>Block</B></FONT> <FONT COLOR="white" POINT-SIZE="11">  blocks</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F8FAFC" CELLPADDING="7"><FONT COLOR="#132338" POINT-SIZE="12"><B>_id</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F8FAFC" CELLPADDING="7"><FONT COLOR="#526578" POINT-SIZE="11">ObjectId</FONT> <FONT COLOR="#D97706" POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#132338" POINT-SIZE="12"><B>blocker</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#526578" POINT-SIZE="11">ObjectId → Profile</FONT> <FONT COLOR="#D97706" POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F8FAFC" CELLPADDING="7"><FONT COLOR="#132338" POINT-SIZE="12"><B>blocked</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F8FAFC" CELLPADDING="7"><FONT COLOR="#526578" POINT-SIZE="11">ObjectId → Profile</FONT> <FONT COLOR="#D97706" POINT-SIZE="9">FK</FONT></TD></TR></TABLE>>]
	Team [label=<<TABLE BORDER="1" COLOR="#059669" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#059669" CELLPADDING="12"><FONT COLOR="white" POINT-SIZE="18"><B>Team</B></FONT> <FONT COLOR="white" POINT-SIZE="11">  teams</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F8FAFC" CELLPADDING="7"><FONT COLOR="#132338" POINT-SIZE="12"><B>_id</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F8FAFC" CELLPADDING="7"><FONT COLOR="#526578" POINT-SIZE="11">ObjectId</FONT> <FONT COLOR="#059669" POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#132338" POINT-SIZE="12"><B>event</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#526578" POINT-SIZE="11">ObjectId → Event</FONT> <FONT COLOR="#059669" POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F8FAFC" CELLPADDING="7"><FONT COLOR="#132338" POINT-SIZE="12"><B>owner</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F8FAFC" CELLPADDING="7"><FONT COLOR="#526578" POINT-SIZE="11">ObjectId → Profile</FONT> <FONT COLOR="#059669" POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#132338" POINT-SIZE="12"><B>members</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#526578" POINT-SIZE="11">ObjectId[] → Profile</FONT> <FONT COLOR="#059669" POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F8FAFC" CELLPADDING="7"><FONT COLOR="#132338" POINT-SIZE="12"><B>name</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F8FAFC" CELLPADDING="7"><FONT COLOR="#526578" POINT-SIZE="11">string</FONT></TD></TR></TABLE>>]
	Profile [label=<<TABLE BORDER="1" COLOR="#2563EB" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#2563EB" CELLPADDING="12"><FONT COLOR="white" POINT-SIZE="18"><B>Profile</B></FONT> <FONT COLOR="white" POINT-SIZE="11">  profiles</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F8FAFC" CELLPADDING="7"><FONT COLOR="#132338" POINT-SIZE="12"><B>_id</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F8FAFC" CELLPADDING="7"><FONT COLOR="#526578" POINT-SIZE="11">ObjectId</FONT> <FONT COLOR="#2563EB" POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#132338" POINT-SIZE="12"><B>handle</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#526578" POINT-SIZE="11">string</FONT> <FONT COLOR="#2563EB" POINT-SIZE="9">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F8FAFC" CELLPADDING="7"><FONT COLOR="#132338" POINT-SIZE="12"><B>name</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F8FAFC" CELLPADDING="7"><FONT COLOR="#526578" POINT-SIZE="11">string</FONT></TD></TR></TABLE>>]
	HelpRequest [label=<<TABLE BORDER="1" COLOR="#D97706" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#D97706" CELLPADDING="12"><FONT COLOR="white" POINT-SIZE="18"><B>HelpRequest</B></FONT> <FONT COLOR="white" POINT-SIZE="11">  help</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F8FAFC" CELLPADDING="7"><FONT COLOR="#132338" POINT-SIZE="12"><B>_id</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F8FAFC" CELLPADDING="7"><FONT COLOR="#526578" POINT-SIZE="11">ObjectId</FONT> <FONT COLOR="#D97706" POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#132338" POINT-SIZE="12"><B>event</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#526578" POINT-SIZE="11">ObjectId → Event</FONT> <FONT COLOR="#D97706" POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F8FAFC" CELLPADDING="7"><FONT COLOR="#132338" POINT-SIZE="12"><B>hacker</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F8FAFC" CELLPADDING="7"><FONT COLOR="#526578" POINT-SIZE="11">ObjectId → Profile</FONT> <FONT COLOR="#D97706" POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#132338" POINT-SIZE="12"><B>status</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#526578" POINT-SIZE="11">enum</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F8FAFC" CELLPADDING="7"><FONT COLOR="#132338" POINT-SIZE="12"><B>mentor</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F8FAFC" CELLPADDING="7"><FONT COLOR="#526578" POINT-SIZE="11">ObjectId → Profile</FONT> <FONT COLOR="#D97706" POINT-SIZE="9">FK</FONT></TD></TR></TABLE>>]
	Event -> Team [label=" event " arrowhead=crowodot arrowtail=tee color="#8A9DB4" constraint=true fontcolor="#334155" headlabel="0..N" labelangle=15 labeldistance=1.2 minlen=1 style=solid taillabel=1 tooltip="Event 1 to Team 0..N: Each Team belongs to one Event"]
	Profile -> Team [label=" owner " arrowhead=crowodot arrowtail=tee color="#8A9DB4" constraint=true fontcolor="#334155" headlabel="0..N" labelangle=15 labeldistance=1.2 minlen=1 style=solid taillabel=1 tooltip="Profile 1 to Team 0..N: Each Team has one owner"]
	Team -> Profile [label=" members[] " arrowhead=crowtee arrowtail=crowodot color="#8A9DB4" constraint=true fontcolor="#334155" headlabel="1..N" labelangle=15 labeldistance=1.2 minlen=1 style=solid taillabel="0..N" tooltip="Team 0..N to Profile 1..N: Each Team contains its owner; each Profile belongs to at most one Team per Event"]
	Profile -> Block [label=" blocker " arrowhead=crowodot arrowtail=tee color="#8A9DB4" constraint=true fontcolor="#334155" headlabel="0..N" labelangle=15 labeldistance=1.2 minlen=1 style=solid taillabel=1 tooltip="Profile 1 to Block 0..N: Blocking profile is required"]
	Profile -> Block [label=" blocked " arrowhead=crowodot arrowtail=tee color="#8A9DB4" constraint=true fontcolor="#334155" headlabel="0..N" labelangle=15 labeldistance=1.2 minlen=1 style=solid taillabel=1 tooltip="Profile 1 to Block 0..N: Blocked profile is required"]
	Event -> ConnectionRequest [label=" event " arrowhead=crowodot arrowtail=tee color="#8A9DB4" constraint=true fontcolor="#334155" headlabel="0..N" labelangle=15 labeldistance=1.2 minlen=1 style=solid taillabel=1 tooltip="Event 1 to ConnectionRequest 0..N: One Event per request"]
	Profile -> ConnectionRequest [label=" from " arrowhead=crowodot arrowtail=tee color="#8A9DB4" constraint=true fontcolor="#334155" headlabel="0..N" labelangle=15 labeldistance=1.2 minlen=1 style=solid taillabel=1 tooltip="Profile 1 to ConnectionRequest 0..N: Request sender"]
	Profile -> ConnectionRequest [label=" to " arrowhead=crowodot arrowtail=tee color="#8A9DB4" constraint=true fontcolor="#334155" headlabel="0..N" labelangle=15 labeldistance=1.2 minlen=1 style=solid taillabel=1 tooltip="Profile 1 to ConnectionRequest 0..N: Request recipient"]
	Team -> ConnectionRequest [label=" team [optional] " arrowhead=crowodot arrowtail=odottee color="#8A9DB4" constraint=true fontcolor="#334155" headlabel="0..N" labelangle=15 labeldistance=1.2 minlen=1 style=solid taillabel="0..1" tooltip="Team 0..1 to ConnectionRequest 0..N: Team reference only on join requests"]
	Event -> HelpRequest [label=" event " arrowhead=crowodot arrowtail=tee color="#8A9DB4" constraint=true fontcolor="#334155" headlabel="0..N" labelangle=15 labeldistance=1.2 minlen=1 style=solid taillabel=1 tooltip="Event 1 to HelpRequest 0..N: One Event per help request"]
	Profile -> HelpRequest [label=" hacker " arrowhead=crowodot arrowtail=tee color="#8A9DB4" constraint=false fontcolor="#334155" headlabel="0..N" labelangle=15 labeldistance=1.2 minlen=1 style=solid taillabel=1 tooltip="Profile 1 to HelpRequest 0..N: Each help request has one hacker"]
	Profile -> HelpRequest [label=" mentor [optional] " arrowhead=crowodot arrowtail=odottee color="#8A9DB4" constraint=false fontcolor="#334155" headlabel="0..N" labelangle=15 labeldistance=1.2 minlen=1 style=solid taillabel="0..1" tooltip="Profile 0..1 to HelpRequest 0..N: Open requests have no mentor"]
}

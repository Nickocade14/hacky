	User -> Profile [label=" same _id " arrowhead=tee arrowtail=tee color="#7C8A9E" constraint=true fontcolor="#334155" headlabel=1 labelangle=15 labeldistance=1.2 minlen=1 style=dashed taillabel=1 tooltip="User 1 to Profile 1: Public profile shares User._id, not a declared ref"]

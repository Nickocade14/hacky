	Event -> Team [label=" event " arrowhead=crowodot arrowtail=tee color="#8A9DB4" constraint=true fontcolor="#334155" headlabel="0..N" labelangle=15 labeldistance=1.2 minlen=1 style=solid taillabel=1 tooltip="Event 1 to Team 0..N: Each Team belongs to one Event"]
	Profile -> Team [label=" owner " arrowhead=crowodot arrowtail=tee color="#8A9DB4" constraint=true fontcolor="#334155" headlabel="0..N" labelangle=15 labeldistance=1.2 minlen=1 style=solid taillabel=1 tooltip="Profile 1 to Team 0..N: Each Team has one owner"]
	Team -> Profile [label=" members[] " arrowhead=crowtee arrowtail=crowodot color="#8A9DB4" constraint=true fontcolor="#334155" headlabel="1..N" labelangle=15 labeldistance=1.2 minlen=1 style=solid taillabel="0..N" tooltip="Team 0..N to Profile 1..N: Each Team contains its owner; each Profile belongs to at most one Team per Event"]
	Event -> HelpRequest [label=" event " arrowhead=crowodot arrowtail=tee color="#8A9DB4" constraint=true fontcolor="#334155" headlabel="0..N" labelangle=15 labeldistance=1.2 minlen=1 style=solid taillabel=1 tooltip="Event 1 to HelpRequest 0..N: One Event per help request"]
	Profile -> HelpRequest [label=" hacker " arrowhead=crowodot arrowtail=tee color="#8A9DB4" constraint=true fontcolor="#334155" headlabel="0..N" labelangle=15 labeldistance=1.2 minlen=1 style=solid taillabel=1 tooltip="Profile 1 to HelpRequest 0..N: Each help request has one hacker"]
	Profile -> HelpRequest [label=" mentor [optional] " arrowhead=crowodot arrowtail=odottee color="#8A9DB4" constraint=true fontcolor="#334155" headlabel="0..N" labelangle=15 labeldistance=1.2 minlen=1 style=solid taillabel="0..1" tooltip="Profile 0..1 to HelpRequest 0..N: Open requests have no mentor"]
	Event -> Conversation [label=" event " arrowhead=crowodot arrowtail=tee color="#8A9DB4" constraint=true fontcolor="#334155" headlabel="0..N" labelangle=15 labeldistance=1.2 minlen=1 style=solid taillabel=1 tooltip="Event 1 to Conversation 0..N: One Event per Conversation"]
	Profile -> Conversation [label=" members[].user " arrowhead=crowodot arrowtail=crowtee color="#8A9DB4" constraint=true fontcolor="#334155" headlabel="0..N" labelangle=15 labeldistance=1.2 minlen=1 style=solid taillabel="1..N" tooltip="Profile 1..N to Conversation 0..N: Embedded members with user ObjectId ref; DM has exactly 2"]
	Profile -> Conversation [label=" dmUserLow / High " arrowhead=crowodot arrowtail=odottee color="#8A9DB4" constraint=true fontcolor="#334155" headlabel="0..N" labelangle=15 labeldistance=1.2 minlen=1 style=solid taillabel="0..1" tooltip="Profile 0..1 to Conversation 0..N: Conditional DM references, each optional field"]
	Team -> Conversation [label=" team [optional] " arrowhead=odottee arrowtail=odottee color="#8A9DB4" constraint=true fontcolor="#334155" headlabel="0..1" labelangle=15 labeldistance=1.2 minlen=1 style=solid taillabel="0..1" tooltip="Team 0..1 to Conversation 0..1: Unique partial index on Team conversation; only for kind=team"]
	HelpRequest -> Conversation [label=" helpRequest [optional] " arrowhead=odottee arrowtail=odottee color="#8A9DB4" constraint=false fontcolor="#334155" headlabel="0..1" labelangle=15 labeldistance=1.2 minlen=1 style=solid taillabel="0..1" tooltip="HelpRequest 0..1 to Conversation 0..1: Unique partial index; only for kind=mentor"]
	Conversation -> Message [label=" conversation " arrowhead=crowodot arrowtail=tee color="#8A9DB4" constraint=false fontcolor="#334155" headlabel="0..N" labelangle=15 labeldistance=1.2 minlen=1 style=solid taillabel=1 tooltip="Conversation 1 to Message 0..N: Each message belongs to one Conversation"]
	Profile -> Message [label=" sender [optional] " arrowhead=crowodot arrowtail=odottee color="#8A9DB4" constraint=false fontcolor="#334155" headlabel="0..N" labelangle=15 labeldistance=1.2 minlen=1 style=solid taillabel="0..1" tooltip="Profile 0..1 to Message 0..N: System messages do not have senders"]
	Profile -> AgentMessage [label=" user " arrowhead=crowodot arrowtail=tee color="#8A9DB4" constraint=false fontcolor="#334155" headlabel="0..N" labelangle=15 labeldistance=1.2 minlen=1 style=solid taillabel=1 tooltip="Profile 1 to AgentMessage 0..N: One Profile for each AI history row"]
	Event -> AgentMessage [label=" event " arrowhead=crowodot arrowtail=tee color="#8A9DB4" constraint=false fontcolor="#334155" headlabel="0..N" labelangle=15 labeldistance=1.2 minlen=1 style=solid taillabel=1 tooltip="Event 1 to AgentMessage 0..N: One Event for each AI history row"]

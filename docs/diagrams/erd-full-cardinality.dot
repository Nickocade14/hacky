	Profile -> Block [label=" blocked " arrowhead=crowodot arrowtail=tee color="#8A9DB4" constraint=false fontcolor="#334155" headlabel="0..N" labelangle=15 labeldistance=1.2 minlen=2 style=solid taillabel=1 tooltip="Profile 1 to Block 0..N: Blocked profile is required"]
	Event -> ConnectionRequest [label=" event " arrowhead=crowodot arrowtail=tee color="#8A9DB4" constraint=false fontcolor="#334155" headlabel="0..N" labelangle=15 labeldistance=1.2 minlen=2 style=solid taillabel=1 tooltip="Event 1 to ConnectionRequest 0..N: One Event per request"]
	Profile -> ConnectionRequest [label=" from " arrowhead=crowodot arrowtail=tee color="#8A9DB4" constraint=false fontcolor="#334155" headlabel="0..N" labelangle=15 labeldistance=1.2 minlen=2 style=solid taillabel=1 tooltip="Profile 1 to ConnectionRequest 0..N: Request sender"]
	Profile -> ConnectionRequest [label=" to " arrowhead=crowodot arrowtail=tee color="#8A9DB4" constraint=false fontcolor="#334155" headlabel="0..N" labelangle=15 labeldistance=1.2 minlen=2 style=solid taillabel=1 tooltip="Profile 1 to ConnectionRequest 0..N: Request recipient"]
	Team -> ConnectionRequest [label=" team [optional] " arrowhead=crowodot arrowtail=odottee color="#8A9DB4" constraint=false fontcolor="#334155" headlabel="0..N" labelangle=15 labeldistance=1.2 minlen=2 style=solid taillabel="0..1" tooltip="Team 0..1 to ConnectionRequest 0..N: Team reference only on join requests"]
	Event -> HelpRequest [label=" event " arrowhead=crowodot arrowtail=tee color="#8A9DB4" constraint=false fontcolor="#334155" headlabel="0..N" labelangle=15 labeldistance=1.2 minlen=2 style=solid taillabel=1 tooltip="Event 1 to HelpRequest 0..N: One Event per help request"]
	Profile -> HelpRequest [label=" hacker " arrowhead=crowodot arrowtail=tee color="#8A9DB4" constraint=false fontcolor="#334155" headlabel="0..N" labelangle=15 labeldistance=1.2 minlen=2 style=solid taillabel=1 tooltip="Profile 1 to HelpRequest 0..N: Each help request has one hacker"]
	Profile -> HelpRequest [label=" mentor [optional] " arrowhead=crowodot arrowtail=odottee color="#8A9DB4" constraint=false fontcolor="#334155" headlabel="0..N" labelangle=15 labeldistance=1.2 minlen=2 style=solid taillabel="0..1" tooltip="Profile 0..1 to HelpRequest 0..N: Open requests have no mentor"]
	Event -> Conversation [label=" event " arrowhead=crowodot arrowtail=tee color="#8A9DB4" constraint=false fontcolor="#334155" headlabel="0..N" labelangle=15 labeldistance=1.2 minlen=2 style=solid taillabel=1 tooltip="Event 1 to Conversation 0..N: One Event per Conversation"]

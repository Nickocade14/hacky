	Team -> Conversation [label=" team [optional] " arrowhead=odottee arrowtail=odottee color="#8A9DB4" constraint=false fontcolor="#334155" headlabel="0..1" labelangle=15 labeldistance=1.2 minlen=2 style=solid taillabel="0..1" tooltip="Team 0..1 to Conversation 0..1: Unique partial index on Team conversation; only for kind=team"]
	HelpRequest -> Conversation [label=" helpRequest [optional] " arrowhead=odottee arrowtail=odottee color="#8A9DB4" constraint=false fontcolor="#334155" headlabel="0..1" labelangle=15 labeldistance=1.2 minlen=2 style=solid taillabel="0..1" tooltip="HelpRequest 0..1 to Conversation 0..1: Unique partial index; only for kind=mentor"]

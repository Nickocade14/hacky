	User -> AuthCode [label=" user " arrowhead=crowodot arrowtail=tee color="#8A9DB4" constraint=true fontcolor="#334155" headlabel="0..N" labelangle=15 labeldistance=1.2 minlen=2 style=solid taillabel=1 tooltip="User 1 to AuthCode 0..N: Unique per (user, kind); only reset-password kind currently"]
	Event -> Membership [label=" event " arrowhead=crowodot arrowtail=tee color="#8A9DB4" constraint=true fontcolor="#334155" headlabel="0..N" labelangle=15 labeldistance=1.2 minlen=2 style=solid taillabel=1 tooltip="Event 1 to Membership 0..N: Each Membership belongs to exactly one Event"]
	Profile -> Membership [label=" user " arrowhead=crowodot arrowtail=tee color="#8A9DB4" constraint=true fontcolor="#334155" headlabel="0..N" labelangle=15 labeldistance=1.2 minlen=2 style=solid taillabel=1 tooltip="Profile 1 to Membership 0..N: Each Membership belongs to exactly one Profile"]
	Event -> Team [label=" event " arrowhead=crowodot arrowtail=tee color="#8A9DB4" constraint=true fontcolor="#334155" headlabel="0..N" labelangle=15 labeldistance=1.2 minlen=2 style=solid taillabel=1 tooltip="Event 1 to Team 0..N: Each Team belongs to one Event"]
	Profile -> Team [label=" owner " arrowhead=crowodot arrowtail=tee color="#8A9DB4" constraint=true fontcolor="#334155" headlabel="0..N" labelangle=15 labeldistance=1.2 minlen=2 style=solid taillabel=1 tooltip="Profile 1 to Team 0..N: Each Team has one owner"]
	Team -> Profile [label=" members[] " arrowhead=crowtee arrowtail=crowodot color="#8A9DB4" constraint=true fontcolor="#334155" headlabel="1..N" labelangle=15 labeldistance=1.2 minlen=2 style=solid taillabel="0..N" tooltip="Team 0..N to Profile 1..N: Each Team contains its owner; each Profile belongs to at most one Team per Event"]
	Event -> Embedding [label=" event " arrowhead=crowodot arrowtail=tee color="#8A9DB4" constraint=true fontcolor="#334155" headlabel="0..N" labelangle=15 labeldistance=1.2 minlen=2 style=solid taillabel=1 tooltip="Event 1 to Embedding 0..N: Each Embedding belongs to one Event"]
	Profile -> Embedding [label=" ownerId [member] " arrowhead=crowodot arrowtail=odottee color="#7C8A9E" constraint=true fontcolor="#334155" headlabel="0..N" labelangle=15 labeldistance=1.2 minlen=2 style=dashed taillabel="0..1" tooltip="Profile 0..1 to Embedding 0..N: Member embeddings: ownerKind=member, ownerId=Profile._id"]

	Profile -> Message [label=" sender [optional] " arrowhead=crowodot arrowtail=odottee color="#8A9DB4" constraint=false fontcolor="#334155" headlabel="0..N" labelangle=15 labeldistance=1.2 minlen=2 style=solid taillabel="0..1" tooltip="Profile 0..1 to Message 0..N: System messages do not have senders"]
	Profile -> AgentMessage [label=" user " arrowhead=crowodot arrowtail=tee color="#8A9DB4" constraint=false fontcolor="#334155" headlabel="0..N" labelangle=15 labeldistance=1.2 minlen=2 style=solid taillabel=1 tooltip="Profile 1 to AgentMessage 0..N: One Profile for each AI history row"]
	Event -> AgentMessage [label=" event " arrowhead=crowodot arrowtail=tee color="#8A9DB4" constraint=false fontcolor="#334155" headlabel="0..N" labelangle=15 labeldistance=1.2 minlen=2 style=solid taillabel=1 tooltip="Event 1 to AgentMessage 0..N: One Event for each AI history row"]
	User -> Event [minlen=2 style=invis weight=100]
	Event -> ConnectionRequest [minlen=2 style=invis weight=100]
	ConnectionRequest -> Conversation [minlen=2 style=invis weight=100]
}

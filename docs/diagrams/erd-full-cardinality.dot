COLOR="#F8FAFC" CELLPADDING="7"><FONT COLOR="#526578" POINT-SIZE="11">string[]</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#132338" POINT-SIZE="12"><B>experience / goal / track</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#526578" POINT-SIZE="11">enum / string</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F8FAFC" CELLPADDING="7"><FONT COLOR="#132338" POINT-SIZE="12"><B>wantsExperienced</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F8FAFC" CELLPADDING="7"><FONT COLOR="#526578" POINT-SIZE="11">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#132338" POINT-SIZE="12"><B>interests / motivations</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#526578" POINT-SIZE="11">string[]</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F8FAFC" CELLPADDING="7"><FONT COLOR="#132338" POINT-SIZE="12"><B>idea / summary</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F8FAFC" CELLPADDING="7"><FONT COLOR="#526578" POINT-SIZE="11">string</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#132338" POINT-SIZE="12"><B>complete</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#526578" POINT-SIZE="11">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F8FAFC" CELLPADDING="7"><FONT COLOR="#132338" POINT-SIZE="12"><B>createdAt / updatedAt</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F8FAFC" CELLPADDING="7"><FONT COLOR="#526578" POINT-SIZE="11">Date</FONT></TD></TR></TABLE>>]
